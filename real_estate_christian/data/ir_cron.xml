<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="id_cron_finish_contract" model="ir.cron">
        <field name="name">Finish expired contracts</field>
        <field name="model_id" ref="model_real_estate_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_finish_contracts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <record id="id_cron_done_visits" model="ir.cron">
        <field name="name">Finish expired visits</field>
        <field name="model_id" ref="model_real_estate_visit"/>
        <field name="state">code</field>
        <field name="code">model._cron_done_visits()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
