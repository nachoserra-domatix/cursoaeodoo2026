<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="real_estate_visit_batch_wizard_view_form" model="ir.ui.view">
        <field name="name">real.estate.property.batch.wizard.form</field>
        <field name="model">real.estate.property.batch.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Visits">
                <group>
                    <field name="property_id" invisible="1"/>
                    <field name="date_from" widget="daterange" options="{'related_end_date': 'date_to'}"/>
                    <field name="date_to" widget="daterange" options="{'related_start_date': 'date_from'}"/>
                </group>
                <footer>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="real_estate_visit_batch_wizard_action" model="ir.actions.act_window">
        <field name="name">Create Visits</field>
        <field name="res_model">real.estate.property.batch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>