<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="real_estate_property_stage_view_list" model="ir.ui.view">
        <field name="name">real.estate.property.stage.list</field>
        <field name="model">real.estate.property.stage</field>
        <field name="arch" type="xml">
            <list string="Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="real_estate_property_stage_view_form" model="ir.ui.view">
        <field name="name">real.estate.property.stage.form</field>
        <field name="model">real.estate.property.stage</field>
        <field name="arch" type="xml">
            <form string="Stage">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_property_stage_action" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">real.estate.property.stage</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
