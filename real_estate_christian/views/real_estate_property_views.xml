<?xml version="1.0" encoding="utf-8"?>
<odoo>
 
   <record id="real_estate_property_view_kanban" model="ir.ui.view">
        <field name="name">realestate.property.kanban</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" records_draggable="true">
                <field name="stage_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                            </div>
                            <div>
                                <field name="reference"/>
                            </div>
                            <div>
                                <field name="category_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="price" widget="monetary"/>
                                    <field name="availability" widget="boolean_toggle"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

   <record id="real_estate_list_view" model="ir.ui.view">
        <field name="name">realestate.property.list</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties" multi_edit="1">
                <field name="reference" optional="show"/>
                <field name="name" optional="show"/>
                <field name="description" optional="hide"/>
                <field name="price" optional="show" widget="monetary"/>
                <field name="availability" widget="boolean_toggle" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="category_id" optional="show"/>
                <field name="stage_id" optional="show"/>
                <field name="next_visit_date"/>
            </list>
        </field>
    </record>

   <record id="real_estate_form_view" model="ir.ui.view">
        <field name="name">realestate.property.form</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
            <header>
                <button name="action_reserve" string="Reserve" invisible="not availability" type="object" class="btn-primary"/>
                <button name="action_create_visit" string="Create Visit" type="object"/>
                <button name="action_create_offer" string="Create Offer" type="object"/>
                <button name="action_accept_best_offer" string="Accept Best Offer" type="object"/>
                <button name="action_delete_rejected_offers" string="Delete Rejected Offers" type="object" groups="real_estate_christian.group_real_estate_manager"/>
                <button name="action_cancel_visits" string="Cancel visits" type="object" groups="real_estate_christian.group_real_estate_manager"/>
                <button name="action_open_visit_wizard" string="Create Visits (Range)" type="object"/>
            </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" class="oe_stat_button" name="action_view_visits" icon="fa-calendar">
                            <field name="visit_count" widget="statinfo" string="Visits"/>
                        </button>
                        <button type="object" class="oe_stat_button" name="action_view_incidences" icon="fa-wrench">
                            <field name="incidence_count" widget="statinfo" string="Incidences"/>
                        </button>
                        <button type="object" class="oe_stat_button" name="action_view_contracts" icon="fa-file-text-o">
                            <field name="contract_count" widget="statinfo" string="Contracts"/>
                        </button>
                    </div>
                        <widget name="web_ribbon" title="Reserved" invisible="availability" bg_color="text_bg_warning"/>
                    <div class="oe_tittle">
                        <h1>
                            <field name="name" placeholder="Property Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="price" widget="monetary"/>
                            <field name="availability" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="category_id"/>
                            <field name="stage_id"/>
                            <field name="agent_id"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Information">
                            <field string="Information" nolabel="1" name="description"/>
                        </page>
                        <page string="Images">
                            <field name="image_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="image" widget="image" class="oe_avatar"/>
                                </list>
                            </field>
                        </page>
                        <page string="Visits">
                            <field name="visit_ids"
                                context="{'list_view_ref': 'real_estate_christian.real_estate_visit_view_list_simple', 'default_user_id': user_id}"/>
                        </page>
                        <page string="Incidences">
                            <field name="incidence_ids" context="{'default_user_id': user_id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="priority" widget="priority" nolabel="1"/>
                                    <field name="date"/>
                                    <field name="user_id" domain="[('share', '=', False)]"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids">
                                <list editable="bottom">
                                    <field name="buyer_id"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_property_view_search" model="ir.ui.view">
        <field name="name">real.estate.property.search</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name"
                    filter_domain="['|', ('category_id.name', 'ilike', self), ('name', 'ilike', self)]"/>
                <field name="reference"/>
                <field name="category_id"/>
                <filter name="filter_available" string="Available" domain="[('availability', '=', True)]"/>
                <filter name="filter_reserved" string="Reserved" domain="[('availability', '=', False)]"/>
                <separator/>
                <filter name="group_by_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                <filter name="group_by_category" string="Category" context="{'group_by': 'category_id'}"/>
            </search>
        </field>
    </record>

    <record id="real_estate_property_view_pivot" model="ir.ui.view">
        <field name="name">real.estate.property.pivot</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <pivot string="Properties Analysis">
                <field name="user_id" type="row"/>
                <field name="category_id" type="col"/>
                <field name="price" type="measure" widget="monetary"/>
            </pivot>
        </field>
    </record>

    <record id="real_estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">real.estate.property</field>
        <field name="view_mode">kanban,list,form,pivot</field>
        <field name="search_view_id" ref="real_estate_property_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create anew property
            </p>
            <p>
            Fill in the details of the property yoy want to add, such as its name and decription
            </p>
        </field>
    </record>

</odoo>
