<?xml version="1.0" encoding="utf-8"?>
<odoo>
 
    <record id="real_estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">real.estate.property</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create anew property
            </p>
            <p>
            Fill in the details of the property yoy want to add, such as its name and decription
            </p>
        </field>    
    </record>


   <record id="real_estate_list_view" model="ir.ui.view">
        <field name="name">realestate.property.list</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties" multi_edit="1">
                <field name="reference" optional="show"/>
                <field name="name" optional="show"/>
                <field name="description" optional="hide"/>
                <field name="price" optional="show"/>
                <field name="availability" widget="boolean_toggle" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="category_id" optional="show"/>
            </list>
        </field>
    </record>

   <record id="real_estate_form_view" model="ir.ui.view">
        <field name="name">realestate.property.form</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
            <header>
                <button name="action_reserve" string="Reserve" invisible="not availability" type="object" class="btn-primary"/>
            </header>
                <sheet>
                <widget name="web_ribbon" title="Reserved" invisible="availability" bg_color="text_bg_warning"/>
                    <div class="oe_tittle">
                        <h1>
                            <field name="name" placeholder="Property Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="price"/>
                            <field name="availability" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="category_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Information">
                            <field string="Information" nolabel="1" name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


</odoo>
