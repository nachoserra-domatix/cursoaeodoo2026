<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="real_estate_property_incidence_view_list" model="ir.ui.view">
        <field name="name">real.estate.property.incidence.list</field>
        <field name="model">real.estate.property.incidence</field>
        <field name="arch" type="xml">
            <list string="Incidences">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="property_id"/>
                <field name="priority" widget="priority" nolabel="1"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="real_estate_property_incidence_view_form" model="ir.ui.view">
        <field name="name">real.estate.property.incidence.form</field>
        <field name="model">real.estate.property.incidence</field>
        <field name="arch" type="xml">
            <form string="Incidence">
                <header>
                    <field name="state" options="{'clickable': True}" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="property_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_property_incidence_action" model="ir.actions.act_window">
        <field name="name">Incidences</field>
        <field name="res_model">real.estate.property.incidence</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
