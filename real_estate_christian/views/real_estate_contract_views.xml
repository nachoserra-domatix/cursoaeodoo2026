<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="real_estate_contract_view_list" model="ir.ui.view">
        <field name="name">real.estate.contract.list</field>
        <field name="model">real.estate.contract</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="init_date"/>
                <field name="end_date"/>
                <field name="amount"/>
                <field name="deposit"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="real_estate_contract_view_form" model="ir.ui.view">
        <field name="name">real.estate.contract.form</field>
        <field name="model">real.estate.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate" invisible="state != 'draft'" type="object" class="btn-primary"/>
                    <button name="action_finish" string="Finish" invisible="state != 'active'" type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" invisible="state in ('finished', 'canceled')" type="object"/>
                    <field name="state" options="{'clickable': True}" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="property_id"/>
                            <field name="tenant_id"/>
                        </group>
                        <group>
                            <field name="init_date"/>
                            <field name="end_date"/>
                            <field name="amount"/>
                            <field name="deposit"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_contract_action" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">real.estate.contract</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
