<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="real_estate_offer_view_list" model="ir.ui.view">
        <field name="name">real.estate.offer.list</field>
        <field name="model">real.estate.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="property_id"/>
                <field name="category_id"/>
                <field name="buyer_id"/>
                <field name="amount" widget="monetary"/>
                <field name="date"/>
                <field name="state"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="real_estate_offer_view_search" model="ir.ui.view">
        <field name="name">real.estate.offer.search</field>
        <field name="model">real.estate.offer</field>
        <field name="arch" type="xml">
            <search string="Search Offers">
                <filter name="filter_accepted" string="Accepted" domain="[('state', '=', 'accepted')]"/>
                <filter name="filter_sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="group_by_property" string="Property" context="{'group_by': 'property_id'}"/>
            </search>
        </field>
    </record>

   <record id="real_estate_offer_view_kanban" model="ir.ui.view">
        <field name="name">realestate.offer.kanban</field>
        <field name="model">real.estate.offer</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong><field name="date"/></strong>
                            </div>
                            <div>
                                <field name="amount" widget="monetary"/>
                            </div>
                            <div>
                                <field name="buyer_id"/>
                            </div>
                            <div>
                                <field name="property_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="real_estate_offer_view_form" model="ir.ui.view">
        <field name="name">real.estate.offer.form</field>
        <field name="model">real.estate.offer</field>
        <field name="arch" type="xml">
            <form>
            <header>
                <button name="action_draft" string="Draft offer" invisible="state == 'draft'" type="object" class="btn-primary"/>
                <button name="action_sent" string="Offer sent" invisible="state != 'draft'" type="object" class="btn-primary"/>
                <button name="action_accepted" string="Offer accepted" invisible="state != 'sent'" type="object" class="btn-primary"/>
                <button name="action_rejected" string="Offer rejected" invisible="state in ('rejected', 'accepted')" type="object" class="btn-primary"/>
                <button name="action_create_contract" string="Create contract" invisible="state != 'accepted'" type="object" class="btn-primary"/>
                <field name="state" options="{'clickable': True}" widget="statusbar"/>
            </header>
                <sheet>
                    <group>
                        <field name="property_id" domain="[('availability', '=', True)]" options="{'no_create': True, 'no_open': True}"/>
                       <field name="category_id"/>
                        <field name="property_user_id"/>
                        <field name="buyer_id"/>
                    </group>
                    <group>    
                        <field name="amount" widget="monetary"/>
                        <field name="date"/>
                        <field name="state"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_offer_view_graph" model="ir.ui.view">
        <field name="name">real.estate.offer.graph</field>
        <field name="model">real.estate.offer</field>
        <field name="arch" type="xml">
            <graph string="Offers Analysis">
                <field name="state"/>
                <field name="amount" type="measure" widget="monetary"/>
            </graph>
        </field>
    </record>

    <record id="real_estate_offer_view_pivot" model="ir.ui.view">
        <field name="name">real.estate.offer.pivot</field>
        <field name="model">real.estate.offer</field>
        <field name="arch" type="xml">
            <pivot string="Offers Analysis">
                <field name="state" type="row"/>
                <field name="property_id" type="col"/>
                <field name="amount" type="measure" widget="monetary"/>
            </pivot>
        </field>
    </record>

    <record id="real_estate_offer_action" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">real.estate.offer</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="search_view_id" ref="real_estate_offer_view_search"/>
    </record>
</odoo>
