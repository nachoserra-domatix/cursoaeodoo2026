<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="real_estate_owner_view_list" model="ir.ui.view">
        <field name="name">real.estate.owner.list</field>
        <field name="model">real.estate.owner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="city"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>

    <record id="real_estate_owner_view_form" model="ir.ui.view">
        <field name="name">real.estate.owner.form</field>
        <field name="model">real.estate.owner</field>
        <field name="arch" type="xml">
            <form string="Owner">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="street"/>
                        <field name="city"/>
                        <field name="country_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_owner_action" model="ir.actions.act_window">
        <field name="name">Owners</field>
        <field name="res_model">real.estate.owner</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
