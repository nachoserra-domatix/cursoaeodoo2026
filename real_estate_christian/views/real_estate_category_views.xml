<?xml version="1.0" encoding="utf-8"?>
<odoo>
 
    <record id="real_estate_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">real.estate.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create a new category
            </p>
            <p>
            Fill in the details of the category yoy want to add, such as its name and decription
            </p>
        </field>    
    </record>


   <record id="real_estate_category_list_view" model="ir.ui.view">
        <field name="name">realestate.category.list</field>
        <field name="model">real.estate.category</field>
        <field name="arch" type="xml">
            <list string="Categories" multi_edit="1">
                <field name="name" optional="show"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>

   <record id="real_estate_category_form_view" model="ir.ui.view">
        <field name="name">realestate.category.form</field>
        <field name="model">real.estate.category</field>
        <field name="arch" type="xml">
            <form string="Category">
            <header>
            </header>
                <sheet>
                    <field name="name"/>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>


</odoo>
