<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="real_estate_visit_view_list" model="ir.ui.view">
        <field name="name">real.estate.visit.list</field>
        <field name="model">real.estate.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="property_id"/>
                <field name="date"/>
                <field name="contact_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="real_estate_visit_view_form" model="ir.ui.view">
        <field name="name">real.estate.visit.form</field>
        <field name="model">real.estate.visit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="property_id"/>
                        <field name="date"/>
                        <field name="contact_id"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_visit_action" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">real.estate.visit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
