<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="realestate_properties_simple_report" model="ir.actions.report">
        <field name="name">Properties Summary</field>
        <field name="model">realestate.property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate_RCNGC.report_realestate_properties_simple</field>
        <field name="report_file">real_estate_RCNGC.report_realestate_properties_simple</field>
        <field name="print_report_name">'Properties Summary'</field>
        <field name="binding_model_id" ref="real_estate_RCNGC.model_realestate_property"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_realestate_property"/>
    </record>

    <template id="report_realestate_properties_simple">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Properties Summary</h2>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Reference</th>
                                <th>Price</th>
                                <th>Stage</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="property">
                                <tr>
                                    <td><span t-field="property.name"/></td>
                                    <td><span t-field="property.reference"/></td>
                                    <td><span t-field="property.price"/></td>
                                    <td><span t-field="property.stage_id"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>