<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="realestate_contract_report" model="ir.actions.report">
        <field name="name">Real Estate Contract</field>
        <field name="model">realestate.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate_RCNGC.report_realestate_contract</field>
        <field name="report_file">real_estate_RCNGC.report_realestate_contract</field>
        <field name="print_report_name">'Contract - %s' % (object.property_id.name)</field>
        <field name="binding_model_id" ref="real_estate_RCNGC.model_realestate_contract"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_realestate_contract"/>
    </record>

    <template id="report_realestate_contract">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="contract">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Real Estate Contract</h2>
                        <!-- PARTIES -->
                        <h4 class="mt-4">Parties</h4>
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <th>Property</th>
                                    <td><span t-field="contract.property_id"/></td>
                                </tr>
                                <tr>
                                    <th>Tenant / Buyer</th>
                                    <td><span t-field="contract.partner_id"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- CONTRACT INFORMATION -->
                        <h4 class="mt-4">Contract Information</h4>
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <th>Contract Type</th>
                                    <td><span t-field="contract.contract_type"/></td>
                                </tr>
                                <tr>
                                    <th>Start Date</th>
                                    <td><span t-field="contract.start_date"/></td>
                                </tr>
                                <tr>
                                    <th>End Date</th>
                                    <td><span t-field="contract.end_date"/></td> 
                                </tr>
                                <tr>
                                    <th>Rent</th>
                                    <td><span t-field="contract.rent"/></td>
                                </tr>

                                <!-- Only show deposit for rental contracts -->
                                <tr t-if="contract.contract_type == 'rent'">
                                    <th>Deposit</th>
                                    <td><span t-field="contract.deposit"/></td>
                                </tr>
                                <tr>
                                    <th>State</th>
                                    <td><span t-field="contract.state"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>