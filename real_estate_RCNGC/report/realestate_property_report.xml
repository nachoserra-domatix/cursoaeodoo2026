<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="realestate_property_report" model="ir.actions.report">
        <field name="name">Real Estate Property Report</field>
        <field name="model">realestate.property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate_RCNGC.report_realestate_property</field>
        <field name="report_file">real_estate_RCNGC.report_realestate_property</field>  
        <field name="print_report_name">'Real Estate Property - %s' % (object.reference)</field>
        <field name="binding_model_id" ref="real_estate_RCNGC.model_realestate_property"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_realestate_property"/>
    </record>

    <template id="report_realestate_property"> 
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 t-field="o.name"/>
                        <div class="row mt-3 mb-3">
                            <div class="col-4">
                                <strong>Reference:</strong> <span t-field="o.reference"/>  
                            </div>
                            <div class="col-3">
                                <strong>Category:</strong> <span t-field="o.category_id"/>  
                            </div>
                            <div class="col-3">
                                <strong>Price:</strong> <span t-field="o.price"/>  
                            </div>
                        </div>
                            
                        <h4>Images</h4>
                        <t t-if="o.image_ids">
                            <table class="table table-sm o_main_table">
                                <t-head>
                                    <tr>
                                        <th>Image</th>
                                        <th>Description</th>
                                    </tr>
                                </t-head>
                                <t-body>
                                    <t t-foreach="o.image_ids" t-as="image">
                                        <tr>
                                            <td>
                                                <img 
                                                    t-if="image.image" 
                                                    t-att-src="image_data_uri(image.image)" 
                                                    style="max-height: 100px;" t-att-alt="image.name"/>
                                            </td>
                                            <td>
                                                <span t-field="image.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t-body>
                            </table>
                        </t>
                        <p t-else="" class="text-muted">No images available.</p>

                        <h4>Visits</h4>
                        <t t-if="o.visit_ids">
                            <table class="table table-sm o_main_table">
                                <t-head>
                                    <tr>
                                        <th>Date</th>
                                        <th>Visitor</th>
                                        <th>Phone</th>
                                        <th>Status</th>
                                    </tr>
                                </t-head>
                                <t-body>
                                    <t t-foreach="o.visit_ids" t-as="visit">
                                        <tr>
                                            <td><span t-field="visit.date"/></td>
                                            <td><span t-field="visit.partner_id"/></td>
                                            <td><span t-field="visit.phone"/></td>
                                            <td><span t-field="visit.state"/></td>
                                        </tr>
                                    </t>
                                </t-body>
                            </table>
                        </t>
                        <p t-else="" class="text-muted">No visits available.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>