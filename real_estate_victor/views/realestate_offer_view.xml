<odoo>
    <data>

        <record id="view_realestate_offer_form" model="ir.ui.view">
            <field name="name">view.realestate.offer.form</field>
            <field name="model">realestate.offer</field>
            <field name="arch" type="xml">
                <form string="Offer">
                    <header>
                        <button name="action_draft" string="Return to draft" type="object" class="oe_highlight" invisible="status == 'D'"/>
                        <button name="action_sent" string="Send" type="object" class="oe_highlight" invisible="status == 'S'"/>
                        <button name="action_accepted" string="Accept" type="object" class="oe_highlight" invisible="status == 'A'"/>
                        <button name="action_refused" string="Refuse" type="object" class="oe_highlight" invisible="status == 'R'"/>
                        <field name="status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Accepted" bg_color="text-bg-success" invisible="status != 'A'"/>
                        <group name="group_top">
                            <group name="group_left">
                                <p>
                                    Main data
                                </p><br />
                                <field name="property_id"/>
                                <field name="partner_id"/>
                                <field name="offer"/>
                                
                            </group>
                            <group name="group_right">
                                <p>
                                    Details
                                </p><br />
                                <field name="date"/>
                                <field name="status"/>
                                <field name="notes"/>
                            </group>
                        </group>
                        <hr />

                    </sheet>
                </form>    
            </field>
        </record>

        <record id="view_realestate_offer_tree" model="ir.ui.view">
            <field name="name">view.realestate.offer.tree</field>
            <field name="model">realestate.offer</field>
            <field name="arch" type="xml">
                <list string="offers">
                    <field name="property_id"/>
                    <field name="partner_id"/>
                    <field name="status"/>
                </list>
            </field>
        </record>

        <record id="view_realestate_offer_search" model="ir.ui.view">
            <field name="name">view.realestate.offer.search</field>
            <field name="model">realestate.offer</field>
            <field name="arch" type="xml">
                <search string="Foñter offers">
                    <field name="property_id"/>
                    <field name="partner_id"/>
                </search>
            </field>
        </record>

        <record id="action_realestate_offer_view" model="ir.actions.act_window">
            <field name="name">Offers</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">realestate.offer</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Offers
                </p>
                <p>
                    Click 'New' to add new elements
                </p>
            </field>
        </record>

    </data>
</odoo>