<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_realestate_property_view" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">realestate.property</field>
        <field name="view_mode">kanban,list,pivot,graph,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Properties
            </p>
            <p>
                Click 'New' to add new elements
            </p>
        </field>
    </record>


    <record id="view_realestate_property_form" model="ir.ui.view">
        <field name="name">view.realestate.property.form</field>
        <field name="model">realestate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                 <header>
                    <button name="action_reserve" string="Reserve" invisible="not availability" type="object" class="btn-primary"/>
                    <button name="action_create_visit" string="Create Visit" type="object" class="btn-secondary"/>
                    <button name="action_accept_best_offer" class="btn-secondary" string="Accept Best Offer" type="object" />
                    <button name="action_delete_refused_offers" class="btn-danger" string="Delete Refused Offers" type="object" />
                    <button name="action_create_offer" string="Create offer" type="object" class="btn-primary"/>
                    <button name="action_cancel_visits" string="Cancel Visits" type="object" class="btn-danger"/>
                    <field name="stage_id" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Reserved" invisible="availability" bg_color="text-bg-warning"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Property Name"/>
                        </h1>
                    </div>
                    <group name="group_top">
                        <group name="group_left">
                            <p>
                                Main data
                            </p><br />
                            <field name="reference"/>
                            <field name="size"/>
                            <field name="category_id"/>
                            <field name="availability" widget="boolean_toggle"/>
                        </group>
                        <group name="group_right">
                            <p>
                                Details
                            </p><br />
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="price"/>
                            <field name="next_visit_date"/>
                        </group>
                        <notebook>
                            <page string="Information">
                                <field name="desc"/>
                            </page>
                             <page string="Images">
                                <field name="image_ids" context="{'default_name': 'Imagen'}">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="image" widget="image"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Visits">
                                <field name="visit_ids" context="{'list_view_ref':'real_estate_victor.view_realestate_visit_simple_list','default_user_id': user_id}"/>
                            </page>
                            <page string="Incidences">
                                <field name="incidence_ids" context="{'default_user_id': 'user_id'}">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="desc"/>
                                        <field name="priority" widget="priority"/>
                                        <field name="status" widget="badge"/>
                                        <field name="user_id" options="{'no_create':True, 'no_open':True}" domain="[('share','=',False)]" widget="many2one_avatar_user"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Offers">
                                <field name="offer_ids" context="{'default_user_id': 'user_id'}">
                                    <list editable="bottom">
                                        <field name="partner_id"/>
                                        <field name="offer"/>
                                        <field name="date"/>
                                        <field name="status"/>
                                        <field name="notes"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                    <hr />

                </sheet>
            </form>    
        </field>
    </record>

    <record id="view_realestate_property_list" model="ir.ui.view">
        <field name="name">view.realestate.property.list</field>
        <field name="model">realestate.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="reference"/>
                <field name="name"/>
                <field name="size"/>
                <field name="desc"/>
                <field name="category_id" optional="show"/>
                <field name="price" optional="show"/>
                <field name="availability" widget="boolean_toggle" optional="show"/>
                <field name="stage_id" optional="show"/>
                <field name="next_visit_date" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_realestate_property_kanban" model="ir.ui.view">
        <field name="name">view.realestate.property.kanban</field>
        <field name="model">realestate.property</field>
        <field name="arch" type="xml">
            <kanban highlight_color="color" default_group_by="stage_id" on_create="quick_create" class="o_kanban_small_column">
                <field name="name"/>
                <field name="reference"/>
                <field name="category_id"/>
                <field name="price"/>
                <field name="availability"/>
                <field name="user_id"/>
                <field name="stage_id"/>
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Edit</a></t>
                        <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                        <div role="separator" class="dropdown-divider"/>
                        <field name="color" widget="kanban_color_picker"/>
                </t>
                <t t-name="card">
                    <widget name="web_ribbon" title="Reserved" bg_color="text-bg-warning" invisible="availability"/>
                    <field name="name" class="fw-bold fs-5"/>
                    <field name="reference"/>
                    <field name="category_id"/>
                    <footer>
                        <field name="price"/>
                        <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                    </footer>
                    
                </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_realestate_property_pivot" model="ir.ui.view">
        <field name="name">realestate.property.pivot</field>
        <field name="model">realestate.property</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="category_id" type="col"/>
                <field name="user_id" type="row"/>
                <field name="price" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_realestate_property_graph" model="ir.ui.view">
        <field name="name">realestate.property.graph</field>
        <field name="model">realestate.property</field>
        <field name="arch" type="xml">
            <graph>
                <field name="category_id" type="col"/>
                <field name="user_id" type="row"/>
                <field name="price" type="measure"/>
            </graph>
        </field>
    </record>

    
    <record id="view_realestate_property_search" model="ir.ui.view">
        <field name="name">view.realestate.property.search</field>
        <field name="model">realestate.property</field>
        <field name="arch" type="xml">
            <search string="Filter properties">
                <field name="name"/>
                <field name="size"/>
                <filter name="availability" string="Available" domain="[('availability','=',True)]"/>   
                <filter name="reserved" string="Reserved" domain="[('availability','=',False)]"/>
                <filter name="group_by_category" string="Group by Category" context="{'group_by':'category_id'}"/>
            </search>
        </field>
    </record>

</odoo>