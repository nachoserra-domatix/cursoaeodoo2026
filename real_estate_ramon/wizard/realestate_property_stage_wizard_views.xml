<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="realestate_property_stage_wizard_form" model="ir.ui.view">
        <field name="name">realestate.property.stage.wizard.form</field>
        <field name="model">realestate.property.stage.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Property Stage">
                <group>
                    <field name="stage_id"/>
                </group>
                <footer>
                    <button name="action_apply"
                            string="Apply"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="realestate_property_stage_wizard_action" model="ir.actions.act_window">
        <field name="name">Change Property Stage</field>
        <field name="res_model">realestate.property.stage.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_realestate_property"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>