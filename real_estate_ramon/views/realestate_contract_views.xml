<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="realestate_contract_action" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">realestate.contract</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
        Create a new contract
        </p>
        <p>
        Fill in the details of the contract you want to add
        </p>
        </field>
    </record>

    <record id="realestate_contract_list_view" model="ir.ui.view">
        <field name="name">realestate.contract.list</field>
        <field name="model">realestate.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts">
                <field name="name"/>
                <field name="type"/>
                <field name="property_id"/>
                <field name="resident"/>
                <field name="user_id"/>
                <field name="begin_date"/>
                <field name="end_date"/>
                <field name="rent"/>
                <field name="bail"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="realestate_contract_form_view" model="ir.ui.view">
        <field name="name">realestate.contract.form</field>
        <field name="model">realestate.contract</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="property_id" domain="[('availability', '=', False)]"/>
                            <field name="resident" options="{'no_create': True}"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="begin_date"/>
                            <field name="end_date"/>
                            <field name="currency_id"/>
                            <field name="rent"/>
                            <field name="bail"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>