<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="realestate_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">realestate.category</field>
        <field name="view_mode">list, form</field>
        <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
        Create a new category
        </p>
        <p>
        Fill in the details of the category you want to add
        </p>
        </field>
    </record>

    <record id="realestate_category_list_view" model="ir.ui.view">
        <field name="name">realestate.category.list</field>
        <field name="model">realestate.category</field>
        <field name="arch" type="xml">
            <list string="Properties" multi_edit="1">
                <field name="name" optional="show"/>
                <field name="description" optional="show"/>
            </list>
        </field>
    </record>

    <record id="realestate_category_form_view" model="ir.ui.view">
        <field name="name">realestate.category.form</field>
        <field name="model">realestate.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <group>
                    <field name="name"/>
                </group>
                <notebook>
                    <page string="Information">
                        <field name="description"/>
                    </page>
                </notebook>
            </form>

        </field>
    </record>
</odoo>