<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_rental_form" model="ir.ui.view">
        <field name="name">product.template.rental.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="options" position="inside">
                <span name="rental_option" class="d-inline-flex">
                    <field name="rental_ok"/>
                    <label for="rental_ok"/>
                </span>
            </div>
            <field name="type" position="after">
                <field name="property_id" invisible="not rental_ok" required="rental_ok"/>
            </field>
        </field>
    </record>

</odoo>
