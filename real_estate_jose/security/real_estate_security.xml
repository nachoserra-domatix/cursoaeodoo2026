<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="module_category_real_estate" model="ir.module.category">
        <field name="name">Real Estate</field>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_real_estate" model="res.groups.privilege">
        <field name="name">Real Estate</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_real_estate"/>
    </record>

    <record id="group_real_estate_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_real_estate"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_real_estate_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_real_estate"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_real_estate_user'))]"/>
    </record>

    <record id="rule_real_estate_property_user" model="ir.rule">
        <field name="name">Personal Properties</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="domain_force">['|', ('user_id', '=', False), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_real_estate_user'))]"/>
    </record>

    <record id="rule_real_estate_property_manager" model="ir.rule">
        <field name="name">All Properties</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_real_estate_manager'))]"/>
    </record>



</odoo>
