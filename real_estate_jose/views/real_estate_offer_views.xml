<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_real_estate_offer_list" model="ir.ui.view">
        <field name="name">real.estate.offer.list</field>
        <field name="model">real.estate.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="property_id"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_real_estate_offer_form" model="ir.ui.view">
        <field name="name">real.estate.offer.form</field>
        <field name="model">real.estate.offer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_draft"
                            string="Draft"
                            type="object"
                            invisible="state == 'draft'"/>

                    <button name="action_set_sent"
                            string="Send"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'sent'"/>

                    <button name="action_set_accepted"
                            string="Accept"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'accepted'"/>

                    <button name="action_set_rejected"
                            string="Reject"
                            type="object"
                            invisible="state == 'rejected'"/>

                    <field name="state"
                           widget="statusbar"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="property_id"
                                   domain="[('availability', '=', True)]"/>
                            <field name="partner_id"/>
                        </group>

                        <group>
                            <field name="amount"/>
                            <field name="date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_real_estate_offer" model="ir.actions.act_window">
        <field name="res_model">real.estate.offer</field>
        <field name="view_mode">list,graph,form</field>
    </record>

    <record id="view_real_estate_offer_graph" model="ir.ui.view">
        <field name="name">real.estate.offer.graph</field>
        <field name="model">real.estate.offer</field>
        <field name="arch" type="xml">
            <graph string="Offers Analysis">
                <field name="state"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

</odoo>
