<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_real_estate_contract_list" model="ir.ui.view">
        <field name="name">real.estate.contract.list</field>
        <field name="model">real.estate.contract</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="contract_type"/>
                <field name="property_id"/>
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="rent"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_real_estate_contract_form" model="ir.ui.view">
        <field name="name">real.estate.contract.form</field>
        <field name="model">real.estate.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_draft"
                            string="Draft"
                            type="object"
                            invisible="state == 'draft'"/>

                    <button name="action_set_progress"
                            string="Start"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'progress'"/>

                    <button name="action_set_done"
                            string="Finish"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'done'"/>

                    <button name="action_set_cancelled"
                            string="Cancel"
                            type="object"
                            invisible="state == 'cancelled'"/>

                    <field name="state"
                           widget="statusbar"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="contract_type"/>
                            <field name="property_id"/>
                            <field name="partner_id"/>
                        </group>

                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="rent"/>
                            <field name="deposit"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_real_estate_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">real.estate.contract</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
