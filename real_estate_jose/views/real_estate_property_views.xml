<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_real_estate_property_search" model="ir.ui.view">
        <field name="name">real.estate.property.search</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <search>

                <field name="name"
                       string="Property"
                       filter_domain="['|', ('category_id.name', 'ilike', self), ('name', 'ilike', self)]"/>

                <field name="reference"/>
                <field name="category_id"/>

                <separator/>

                <filter name="available"
                        string="Available"
                        domain="[('availability', '=', True)]"/>

                <filter name="reserved"
                        string="Reserved"
                        domain="[('availability', '=', False)]"/>

                <separator/>

                <filter name="group_by_stage"
                        string="Stage"
                        context="{'group_by': 'stage_id'}"/>

                <filter name="group_by_category"
                        string="Category"
                        context="{'group_by': 'category_id'}"/>

            </search>
        </field>
    </record>
    <record id="view_real_estate_property_list" model="ir.ui.view">
        <field name="name">real.estate.property.list</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="reference" optional="show"/>
                <field name="category_id" optional="show"/>
                <field name="name"/>
                <field name="description" optional="hide"/>
                <field name="price" optional="show"/>
                <field name="availability" widget="boolean_toggle" optional="show"/>
                <field name="stage_id"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_real_estate_property_form" model="ir.ui.view">
        <field name="name">real.estate.property.form</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reserve"
                            string="Reserve"
                            type="object"
                            class="btn-primary"
                            invisible="not availability"/>
                    <field name="stage_id"
                           widget="statusbar"/>
                </header>
                <sheet>

                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="name"/>
                            <field name="price"/>
                            <field name="category_id"/>
                        </group>

                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="availability" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Information">
                            <field name="description"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_real_estate_property_kanban" model="ir.ui.view">
        <field name="name">real.estate.property.kanban</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id"
                    class="o_kanban_small_column">

                <field name="stage_id"/>
                <field name="name"/>
                <field name="price"/>
                <field name="category_id"/>
                <field name="user_id"/>

                <templates>
                    <t t-name="card">
                        <div>
                            <strong>
                                <field name="name"/>
                            </strong>
                        </div>

                        <div>
                            Precio:
                            <field name="price"/>
                        </div>

                        <div>
                            Categoría:
                            <field name="category_id"/>
                        </div>

                        <div>
                            Responsable:
                            <field name="user_id"
                                   widget="many2one_avatar_user"/>
                        </div>
                    </t>
                </templates>

            </kanban>
        </field>
    </record>
    <record id="view_real_estate_property_pivot" model="ir.ui.view">
        <field name="name">real.estate.property.pivot</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <pivot string="Properties Analysis">
                <field name="user_id" type="row"/>
                <field name="category_id" type="col"/>
                <field name="price" type="measure"/>
            </pivot>
        </field>
    </record>
</odoo>
