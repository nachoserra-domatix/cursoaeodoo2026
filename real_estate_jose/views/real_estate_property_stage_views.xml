<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_real_estate_property_stage_list" model="ir.ui.view">
        <field name="name">real.estate.property.stage.list</field>
        <field name="model">real.estate.property.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_real_estate_property_stage_form" model="ir.ui.view">
        <field name="name">real.estate.property.stage.form</field>
        <field name="model">real.estate.property.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_real_estate_property_stage" model="ir.actions.act_window">
        <field name="name">Property Stages</field>
        <field name="res_model">real.estate.property.stage</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
