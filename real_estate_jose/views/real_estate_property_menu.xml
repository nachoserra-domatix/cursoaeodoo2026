              name="Categories"
              parent="menu_real_estate_root"
              action="action_real_estate_category"
              sequence="30"/>

    <menuitem id="menu_real_estate_offer"
              name="Offers"
              parent="menu_real_estate_root"
              action="action_real_estate_offer"
              sequence="40"/>

    <menuitem id="menu_real_estate_contract"
              name="Contracts"
              parent="menu_real_estate_root"
              action="action_real_estate_contract"
