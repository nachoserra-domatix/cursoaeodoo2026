<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_real_estate_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">real.estate.property</field>
        <field name="view_mode">kanban,list,pivot,form</field>
        <field name="search_view_id" ref="view_real_estate_property_search"/>
