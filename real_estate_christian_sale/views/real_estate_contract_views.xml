<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="real_estate_contract_view_form_inherit_sale" model="ir.ui.view">
        <field name="name">real.estate.contract.form.inherit.sale</field>
        <field name="model">real.estate.contract</field>
        <field name="inherit_id" ref="real_estate_christian.real_estate_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" class="oe_stat_button" name="action_view_orders" icon="fa-shopping-cart">
                    <field name="order_count" widget="statinfo" string="Sales Orders"/>
                </button>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="action_create_sale_order" string="Create Sale Order" type="object" invisible="not product_id"/>
                <button name="action_confirm_and_invoice" string="Confirm &amp; Invoice" type="object" invisible="not order_ids"/>
            </xpath>
            <xpath expr="//field[@name='amount']" position="after">
                <field name="product_id"/>
            </xpath>
        </field>
    </record>
</odoo>
