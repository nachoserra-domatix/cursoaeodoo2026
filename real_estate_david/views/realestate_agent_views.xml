<?xml version="1.0" encoding="UTF-8"?>
<odoo>

   <record id="realestate_agent_action" model="ir.actions.act_window">
      <field name="name">Agents</field>
      <field name="res_model">realestate.agent</field>
      <field name="view_mode">list,form</field>
   </record>

   <record id="realestate_agent_list" model="ir.ui.view">
      <field name="name">realestate.agent.list</field>
      <field name="model">realestate.agent</field>
      <field name="arch" type="xml">
         <list>
            <field name="name"/>
            <field name="email"/>
            <field name="phone"/>
            <field name="commission"/>
         </list>
      </field>
   </record>

   <record id="realestate_agent_form" model="ir.ui.view">
      <field name="name">realestate.agent.form</field>
      <field name="model">realestate.agent</field>
      <field name="arch" type="xml">
         <form string="Agent">
            <sheet>
               <group>
                  <field name="name"/>
                  <field name="email"/>
                  <field name="phone"/>
                  <field name="commission"/>
               </group>
            </sheet>
         </form>
      </field>
   </record>

</odoo>