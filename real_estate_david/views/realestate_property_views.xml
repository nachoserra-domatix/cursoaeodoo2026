<?xml version="1.0" encoding="UTF-8"?>
<odoo>
   <!-- Action -->
   <record id="realestate_property_action" model="ir.actions.act_window">
      <field name="name">Properties</field>
      <field name="path">properties</field>
      <field name="res_model">realestate.property</field>
      <field name="view_mode">kanban,list,pivot,graph,form</field>
      <field name="help" type="html">
         <p class="o_view_nocontent_smiling_face">Create a new property</p>
         <p>Fill in the details of the property you want to create.</p>
      </field>
   </record>
  
   <!-- List View -->
   <record id="realestate_property_list_view" model="ir.ui.view">
      <field name="name">realestate.property.list</field>
      <field name="model">realestate.property</field>
      <field name="arch" type="xml">
         <list string="Properties" multi_edit="1">
            <field name="reference" optional="show" />
            <field name="category_id" optional="show" />
            <field name="name" optional="show" />
            <field name="description" optional="show" />
            <field name="price" optional="show" />
            <field name="availability" widget="boolean_toggle" optional="show" />
            <field name="stage_id" optional="show" />
            <field name="user_id" widget="many2one_avatar_user" optional="show" />
         </list>
      </field>
   </record>

   <!-- Form View -->
   <record id="realestate_property_form_view" model="ir.ui.view">
      <field name="name">realestate.property.form</field>
      <field name="model">realestate.property</field>
      <field name="arch" type="xml">
         <form string="Property">
            <header>
               <button name="action_reserve" string="Reserve" invisible="not availability" type="object" class="btn-primary" />
               <button name="action_create_visit" string="Create Visit" type="object" class="btn-secondary" />
               <button name="action_accept_best_offer" string="Accept Best Offer" type="object" class="btn-secondary" />
               <button name="action_deleted_refused_offers" string="Delete Refused Offers" type="object" class="btn-secondary" />
               <button name="action_create_offer" string="Create Offer" type="object" class="btn-secondary" />
               <field name="stage_id" widget="statusbar" />
            </header>
            <sheet>
               <widget name="web_ribbon" title="Reserved" invisible="availability" bg_color="bg-warning" />
               <div class="oe_title">
                  <h1>
                     <field name="name" placeholder="Property Name" />
                  </h1>
               </div>
               <group>
                  <group>
                     <field name="reference" />
                     <field name="category_id" />
                     <field name="price" />
                  </group>
                  <group>
                     <field name="availability" widget="boolean_toggle" />
                     <field name="user_id" widget="many2one_avatar_user" />
                  </group>
               </group>
               <notebook>
                  <page name="Information page" string="Information">
                     <field name="description" />
                  </page>
               </notebook>
            </sheet>
         </form>
      </field>
   </record>

   <!-- Kanban View -->
   <record id="realestate_property_kanban_view" model="ir.ui.view">
      <field name="name">realestate.property.kanban</field>
      <field name="model">realestate.property</field>
      <field name="arch" type="xml">
         <kanban highlight_color="color" default_group_by="stage_id" on_create="quick_create" class="o_kanban_small_column o_opportunity_kanban">
            <field name="name" />
            <field name="reference" />
            <field name="category_id" />
            <field name="price" />
            <field name="availability" />
            <field name="user_id" />
            <field name="stage_id" />
            <templates>
               <t t-name="menu">
                  <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Edit</a></t>
                  <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                  <div role="separator" class="dropdown-divider"/>
                  <field name="color" widget="kanban_color_picker"/>
               </t>
               <t t-name="card">
                  <widget name="web_ribbon" title="Reserved" invisible="availability" bg_color="text-bg-warning" />
                  <field name="name" class="fw-bold fs-5"/>
                  <field name="reference" />
                  <field name="category_id" />
                  <footer>
                     <field name="price" />
                     <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                  </footer>
               </t>
            </templates>
         </kanban>
      </field>
   </record>

   <!-- Pivot View -->
   <record id="realestate_property_pivot_view" model="ir.ui.view">
      <field name="name">realestate.property.pivot</field>
      <field name="model">realestate.property</field>
      <field name="arch" type="xml">
         <pivot>
            <field name="category_id" type="col"/>
            <field name="user_id" type="row"/>
            <field name="price" type="measure"/>
         </pivot>
      </field>
   </record>

   <!-- Graph View -->
   <record id="realestate_property_graph_view" model="ir.ui.view">
      <field name="name">realestate.property.graph</field>
      <field name="model">realestate.property</field>
      <field name="arch" type="xml">
         <graph>
            <field name="category_id" type="col"/>
            <field name="user_id" type="row"/>
            <field name="price" type="measure"/>
         </graph>
      </field>
   </record>

   <!-- Search View -->
   <record id="realestate_property_search_view" model="ir.ui.view">
      <field name="name">realestate.property.search</field>
      <field name="model">realestate.property</field>
      <field name="arch" type="xml">
         <search>
            <field name="name" string="Property" filter_domain="['|',('name','ilike',self),('reference','ilike',self)]"/>
            <field name="category_id" />
            <field name="user_id" />

            <filter name="availability" string="Available" domain="[('availability', '=', True)]" />
            <filter name="reserved" string="Reserved" domain="[('availability', '=', False)]" />

            <filter name="group_by_category" string="Category" context="{'group_by': 'category_id'}" />
         </search>
      </field>
   </record>

</odoo>