<?xml version="1.0" encoding="utf-8"?>
<odoo>

   <!-- Action -->
   <record id="realestate_visit_action" model="ir.actions.act_window">
      <field name="name">Visits</field>
      <field name="path">visits</field>
      <field name="res_model">realestate.visit</field>
      <field name="view_mode">list,kanban,pivot,graph,calendar,form</field>
      <field name="help" type="html">
         <p class="o_view_nocontent_smiling_face">Create a new visit</p>
         <p>Fill in the details of the visit you want to create.</p>
      </field>
   </record>


   <!-- List View -->
   <record id="realestate_visit_list_view" model="ir.ui.view">
      <field name="name">realestate.visit.list</field>
      <field name="model">realestate.visit</field>
      <field name="arch" type="xml">
         <list string="Visits" multi_edit="1">
            <field name="property_id" optional="show" />
            <field name="date" optional="show" />
            <field name="partner_id" optional="show" />
            <field name="user_id" optional="show" />
            <field name="state" optional="show" />
         </list>
      </field>
   </record>

   <!-- Form View -->
   <record id="realestate_visit_form_view" model="ir.ui.view">
      <field name="name">realestate.visit.form</field>
      <field name="model">realestate.visit</field>
      <field name="arch" type="xml">
         <form string="Visit">
            <header>
               <button name="action_draft" string="Draft" type="object" class="btn-primary" invisible="state not in('done','canceled')"/> 
               <button name="action_scheduled" string="Scheduled" type="object" class="btn-secondary" invisible="state in ('scheduled','done','canceled')"/> 
               <button name="action_done" string="Done" type="object" class="btn-secondary" invisible="state in('draft','done','canceled')"/> 
               <button name="action_canceled" string="Canceled" type="object" class="btn-danger" invisible="state in ('canceled')"/> 
               
               <field name="state" widget="statusbar" options="{'clickable': True}" />
            </header>
            <sheet>
               <widget name="web_ribbon" invisible="state != 'canceled'" title="Canceled" bg_color="text-bg-danger"/>
               <group>
                  <group>
                     <field name="property_id" />
                     <field name="user_id" />
                  </group>
                  <group>
                     <field name="date" />
                     <field name="partner_id" />
                     <field name="phone" />
                     <field name="email" />
                  </group>
               </group>
            </sheet>
         </form>
      </field>
   </record>

   <!-- Kanban View -->
   <record id="realestate_visit_kanban_view" model="ir.ui.view">
      <field name="name">realestate.visit.kanban</field>
      <field name="model">realestate.visit</field>
      <field name="arch" type="xml">
         <kanban default_group_by="state" on_create="quick_create" class="o_kanban_small_column">
            <field name="state" />
            <templates>
               <t t-name="menu">
                  <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Edit</a></t>
                  <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
               </t>
               <t t-name="card">
                  <widget name="web_ribbon" title="Canceled" invisible="state != 'canceled'" bg_color="text-bg-danger"/>
                  <field name="property_id" class="fw-bold fs-5" />
                  <field name="date" />
                  <footer>
                     <field name="partner_id" />
                     <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                  </footer>
               </t>
            </templates>
         </kanban>
      </field>
   </record>

   <!-- Pivot View -->
   <record id="realestate_visit_pivot_view" model="ir.ui.view">
      <field name="name">realestate.visit.pivot</field>
      <field name="model">realestate.visit</field>
      <field name="arch" type="xml">
         <pivot>
            <field name="state" type="row"/>
            <field name="user_id" type="row"/>
            <field name="property_id" type="row"/>
            <field name="date" type="col"/>
         </pivot>
      </field>
   </record>

   <!-- Graph View -->
   <record id="realestate_visit_graph_view" model="ir.ui.view">
      <field name="name">realestate.visit.graph</field>
      <field name="model">realestate.visit</field>
      <field name="arch" type="xml">
         <graph>
            <field name="state" type="row"/>
            <field name="user_id" type="row"/>
            <field name="property_id" type="row"/>
            <field name="date" type="col"/>
         </graph>
      </field>
   </record>

   <!-- Calendar View -->
   <record id="realestate_visit_calendar_view" model="ir.ui.view">
      <field name="name">realestate.visit.calendar</field>
      <field name="model">realestate.visit</field>
      <field name="arch" type="xml">
         <calendar string="Visits" date_start="date" color="user_id">
            <field name="property_id"/>
            <field name="state"/>
            <field name="partner_id"/>
            <field name="user_id"/>
         </calendar>
      </field>
   </record>

   <!-- Search View -->
   <record id="realestate_visit_search_view" model="ir.ui.view">
      <field name="name">realestate.visit.search</field>
      <field name="model">realestate.visit</field>
      <field name="arch" type="xml">
         <search>
            <field name="property_id" />
            <field name="date" />
            <field name="user_id" />

            <filter name="draft" string="Draft" domain="[('state', '=', 'scheduled')]" />
            <filter name="Scheduled" string="Scheduled" domain="[('state', '=', 'scheduled')]" />
            <filter name="done" string="Done" domain="[('state', '=', 'done')]" />
            <filter name="canceled" string="Canceled" domain="[('state', '=', 'canceled')]" />

            <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}" />
            <filter name="group_by_property" string="Property" context="{'group_by': 'property_id'}" />
            <filter name="group_by_state" string="State" context="{'group_by': 'state'}" />
         </search>
      </field>
   </record>

</odoo>
