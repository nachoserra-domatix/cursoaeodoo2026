<?xml version="1.0" encoding="utf-8"?>
<odoo>

   <!-- Action -->
   <record id="realestate_contract_action" model="ir.actions.act_window">
      <field name="name">Contracts</field>
      <field name="path">contracts</field>
      <field name="res_model">realestate.contract</field>
      <field name="view_mode">list,form</field>
      <field name="help" type="html">
         <p class="o_view_nocontent_smiling_face">Create a new contract</p>
         <p>Fill in the details of the contract you want to create.</p>
      </field>
   </record>

   <!-- List View -->
   <record id="realestate_contract_list_view" model="ir.ui.view">
      <field name="name">realestate.contract.list</field>
      <field name="model">realestate.contract</field>
      <field name="arch" type="xml">
         <list string="Contracts" multi_edit="1">
            <field name="name" />
            <field name="contract_type" />
            <field name="property_id"/>
            <field name="partner_id" />
            <field name="start_date"  optional="show" />
            <field name="end_date"  optional="show" />
            <field name="days_in_progress"  optional="show" />
            <field name="rent"  optional="show" />
            <field name="deposit"  optional="show" />
            <field name="state" optional="show" />
         </list>
      </field>
   </record>

   <!-- Form View -->
   <record id="realestate_contract_form_view" model="ir.ui.view">
      <field name="name">realestate.contract.form</field>
      <field name="model">realestate.contract</field>
      <field name="arch" type="xml">
         <form string="Contract">
            <header>
               <button name="action_draft" string="Draft" type="object" invisible="state == 'draft'" class="btn-secondary"/>
               <button name="action_in_progress" string="In Progress" type="object" invisible="state != 'draft'" class="btn-success"/>
               <button name="action_finished" string="Finished" type="object" invisible="state != 'in_progress'" class="btn-primary"/>
               <button name="action_canceled" string="Canceled" type="object" invisible="state == 'canceled'" class="btn-danger"/>

               <field name="state" widget="statusbar"/>
            </header>
            <sheet>
               <div class="oe_title">
                  <h1>
                     <field name="name" placeholder="Contract Name"/>
                  </h1>
               </div>
               <group>
                  <group>
                     <field name="partner_id" />
                     <field name="contract_type" />
                     <field name="property_id" />
                  </group>
                  <group>
                     <field name="start_date" />
                     <field name="end_date" />
                     <field name="duration_days" />
                     <field name="days_in_progress" />
                     <field name="days_to_end" />
                     <field name="rent" />
                     <field name="deposit" />
                     <field name="has_deposit" />
                  </group>
               </group>
            </sheet>
         </form>
      </field>
   </record>



</odoo>
