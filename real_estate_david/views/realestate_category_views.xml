<?xml version="1.0" encoding="utf-8"?>
<odoo>

   <!-- Action -->
   <record id="realestate_category_action" model="ir.actions.act_window">
      <field name="name">Categories</field>
      <field name="path">categories</field>
      <field name="res_model">realestate.category</field>
      <field name="view_mode">list,form</field>
      <field name="help" type="html">
         <p class="o_view_nocontent_smiling_face">Create a new category</p>
         <p>Fill in the details of the category you want to create.</p>
      </field>
   </record>

   <!-- List View -->
   <record id="realestate_category_list_view" model="ir.ui.view">
      <field name="name">realestate.category.list</field>
      <field name="model">realestate.category</field>
      <field name="arch" type="xml">
         <list string="Categories" multi_edit="1">
            <field name="name" />
            <field name="description" optional="show" />
         </list>
      </field>
   </record>

   <!-- Form View -->
   <record id="realestate_category_form_view" model="ir.ui.view">
      <field name="name">realestate.category.form</field>
      <field name="model">realestate.category</field>
      <field name="arch" type="xml">
         <form string="Category">
            <sheet>
               <div class="oe_title">
                  <h1>
                     <field name="name" />
                  </h1>
               </div>
               <group>
                  <field name="description" />
               </group>
            </sheet>
         </form>
      </field>
   </record>



</odoo>
