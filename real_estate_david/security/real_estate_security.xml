<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <!-- Real Estate Settings -->
   <record id="module_category_real_estate" model="ir.module.category">
      <field name="name">Real Estate Settings</field>
      <field name='sequence'>10</field>
   </record>

   <!-- Real Estate Privilege -->
   <record id="res_group_privilege_real_estate" model="res.groups.privilege">
      <field name="name">Real Estate Privilege</field>
      <field name="sequence">10</field>
      <field name="category_id" ref="module_category_real_estate"/>
   </record>

   <!-- Real Estate Groups -->
   <record id="group_real_estate_user" model="res.groups">
      <field name="name">User</field>
      <field name="privilege_id" ref="res_group_privilege_real_estate"/>
      <field name="comment">Real Estate User Group</field>
   </record>

   <record id="group_real_estate_manager" model="res.groups">
      <field name="name">Manager</field>
      <field name="privilege_id" ref="res_group_privilege_real_estate"/>
      <field name="implied_ids" eval="[(4, ref('group_real_estate_user'))]"/>
      <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
      <field name="comment">Real Estate Manager Group</field>
   </record>

   <!-- Real Estate Rules -->
   <record id="real_estate_rule_user" model="ir.rule">
      <field name="name">Personal Properties</field>
      <field name="model_id" ref="model_realestate_property"/>
      <field name="domain_force" >['|',('user_id','=',user.id),('user_id','=',False)]</field>
      <field name="groups" eval="[(4, ref('group_real_estate_user'))]"/>
   </record>

   <record id="real_estate_rule_manager" model="ir.rule">
      <field name="name">Manager Properties</field>
      <field name="model_id" ref="model_realestate_property"/>
      <field name="domain_force" >[(1,'=',1)]</field>
      <field name="groups" eval="[(4, ref('group_real_estate_manager'))]"/>
   </record>

   

</odoo>
