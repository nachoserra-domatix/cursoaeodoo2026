<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="realestate_property_change_stage_action" model="ir.actions.act_window">
   <field name="name">Change property stage</field>
   <field name="res_model">realestate.property.change.stage</field>
   <field name="view_mode">form</field>
   <field name="target">new</field>
   <!-- En qué modelo va a mostrarse -->
   <field name="binding_model_id" ref="real_estate_david.model_realestate_property" />
   <!-- En qué tipo de vista va a mostrarse -->
   <field name="binding_view_types">list</field>  
</record>

<record id="realestate_property_change_stage_view_form" model="ir.ui.view">
   <field name="name">realestate_property_change_stage_view_form</field>
   <field name="model">realestate.property.change.stage</field>
   <field name="arch" type="xml">
      <form string="Change Property Stage">
            <group>
               <field name="stage_id" />   
            </group>
            <footer>
               <button string="Change stage" type="object" name="action_change_stage" class="btn-primary" ></button>
               <button string="Cancel" special="cancel" ></button>
            </footer>
      </form>
   </field>
</record>
</odoo>
