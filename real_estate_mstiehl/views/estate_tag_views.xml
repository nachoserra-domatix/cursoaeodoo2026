<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- ###### Tag -->  

        <record id="estate_tag_view_list" model="ir.ui.view">
            <field name="name">estate.tag.view.list</field>
            <field name="model">estate.tag</field>
            <field name="arch" type="xml">
                <list string="Real Estate Property Tag" default_order="name desc">
                    <field name="name" />
                    <field name="color" widget="color_picker" />
                    <field name="active" />
                </list>
            </field>
        </record>

        <record id="estate_tag_view_form" model="ir.ui.view">
            <field name="name">estate.tag.view.form</field>
            <field name="model">estate.tag</field>
            <field name="arch" type="xml">
                <form string="Real Estate Property Tag">
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="color" widget="color_picker" />
                            <field name="active" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <!-- Action -->
        <record id="estate_tag_view_action" model="ir.actions.act_window">
            <field name="name">Estate Tags</field>
            <field name="res_model">estate.tag</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
