<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="view_realestate_property_list" model="ir.ui.view">
            <field name="name">realestate.property.list</field>
            <field name="model">realestate.property</field>
            <field name="arch" type="xml">
                <list string="Real Estate Properties" default_order="date_register desc">
                    <field name="name" />
                    <field name="price" />
                    <field name="property_type_id" />
                    <field name="bedrooms" />
                    <field name="bathrooms" />
                    <field name="active" />
                </list>
            </field>
        </record>


        <record id="realestate_property_view_form" model="ir.ui.view">
            <field name="name">realestate.view.form</field>
            <field name="model">realestate.property</field>
            <field name="arch" type="xml">
                <form string="Real Estate Property">
                    <sheet>
                        <field name="image_1920" widget='image' class="oe_avatar" options='{"preview_image": "avatar_128"}' readonly="1"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <field name="description" />
                            <field name="property_type_id" />
                            <field name="bedrooms" />
                            <field name="bathrooms" />
                            <field name="garage" />
                            <field name="external_url" />
                            <field name="date_register" />
                            <field name="active" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <!-- Action -->
        <record id="action_realestate_property" model="ir.actions.act_window">
            <field name="name">Properties</field>
            <field name="res_model">realestate.property</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
