<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <!-- ###### Properties -->

        <record id="estate_property_view_list" model="ir.ui.view">
            <field name="name">estate.property.view.list</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <list string="Real Estate Properties" default_order="date_register desc">
                    <field name="name" />
                    <field name="property_ref_code" />
                    <field name="property_type_id" />
                    <field name="total_area" />
                    <field name="available" />
                </list>
            </field>
        </record>

        <record id="estate_property_view_form" model="ir.ui.view">
            <field name="name">estate.property.view.form</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <form string="Real Estate Property">
                    <header>
                        <widget name="web_ribbon"
                            title="Reserved" 
                            bg_color="text-bg-warning" 
                            invisible="available"/>
                    </header>           
                    <sheet>
                        <field name="image_1920" widget='image' class="oe_avatar"/>
                        <group>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        </group>
                        <group>
                            <field name="property_ref_code"/>
                        </group>
                        <group> <field name="tags_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_edit_color': True}"/>  </group>
                        <group col="2">
                            <group>
                                <field name="property_type_id" />
                                <field name="user_id"/>
                                <field name="available"/>
                            </group>
                            <group>
                                <div class="o_address_format" name="div_address">
                                    <field name="street" placeholder="Street..." class="o_address_street"/>
                                    <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                    <field name="city" placeholder="City" class="o_address_city"/>
                                    <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                    <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                    <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                                    <group><field name="google_maps_url"/></group>
                                </div>
                            </group>
                        </group>
                        <notebook>
                            <page name="details" string="Details">
                                <group>
                                    <field name="description" />
                                    <field name="bedrooms" />
                                    <field name="bathrooms" />
                                    <field name="garage" />
                                    <field name="external_url" />
                                    <field name="date_register" />
                                    <field name="active" />
                                </group>
                            </page>
                            <page name="contacts_ids" string="Contacts">
                                <field name="contacts_ids">
                                    <list>                                    
                                        <field name="partner_id" widget="many2one_avatar" />
                                        <field name="role_id" />                                        
                                    </list>
                                    <form>
                                        <group>
                                            <field name="partner_id" widget="many2one_avatar" />
                                            <field name="role_id" />  
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page name="gallery_ids" string="Gallery">
                                <field name="gallery_ids">
                                    <list>                                    
                                        <field name="name" />
                                        <field name="description" />
                                        <field name="image" widget="image" options="{'size': [50, 50]}"/>                               
                                    </list>
                                    <form>
                                        <group>
                                            <field name="name" />
                                            <field name="description" />
                                            <field name="image" widget="image" options="{'size': [50, 50]}"/>                               
                                        </group>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


        <!-- Action -->
        <record id="estate_property_view_action" model="ir.actions.act_window">
            <field name="name">Properties</field>
            <field name="res_model">estate.property</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
