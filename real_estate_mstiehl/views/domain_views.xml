<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View realestate.domain View List -->
    <record id="view_realestate_domains_list" model="ir.ui.view">
        <field name="name">view.realestate.domain.list</field>
        <field name="model">realestate.domain</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View realestate.domain form -->
    <record id="view_realestate_domains_form" model="ir.ui.view">
        <field name="name">view.realestate.domain.form</field>
        <field name="model">realestate.domain</field>
        <field name="arch" type="xml">
            <form string="Domains">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Action realestate.domain -->
    <record id="action_realestate_domains" model="ir.actions.act_window">
        <field name="name">Realestate Domains</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">realestate.domain</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Realestate Domains.
            </p>
        </field>
    </record>


    <!-- View realestate.domain.type View List -->
    <record id="view_realestate_domain_type_list" model="ir.ui.view">
        <field name="name">view.realestate.domain.type.list</field>
        <field name="model">realestate.domain.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View realestate.domain.type form -->
    <record id="view_realestate_domain_type_form" model="ir.ui.view">
        <field name="name">view.realestate.domain.type.form</field>
        <field name="model">realestate.domain.type</field>
        <field name="arch" type="xml">
            <form string="Realestate Domain Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action realestate.domain.type -->
    <record id="action_realestate_domain_type" model="ir.actions.act_window">
        <field name="name">Realestate Domain Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">realestate.domain.type</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Realestate Domain Type.
            </p>
        </field>
    </record>

</odoo>
