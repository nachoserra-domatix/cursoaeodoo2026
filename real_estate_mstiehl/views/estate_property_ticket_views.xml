<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="estate_property_ticket_view_form" model="ir.ui.view">
            <field name="name">estate.property.ticket.view.form</field>
            <field name="model">estate.property.ticket</field>
            <field name="arch" type="xml">
                <form string="Real Estate Property Ticket">
                    <header>
                        <button name="action_in_progress" string="In Progress" type="object" class="oe_highlight" invisible="state != 'new'"/>
                        <button name="action_done" string="Done" type="object" class="oe_highlight btn-success" invisible="state != 'in_progress'"/>
                        <button name="action_canceled" string="Cancel" type="object" invisible="state in ('done', 'canceled')"/>
                        <button name="action_new" string="Reset to New" type="object" invisible="state != 'canceled'"/>
                        <field name="state" widget="statusbar" statusbar_visible="new,in_progress,done" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <field name="ticket_ref_code" class="text-muted"/>
                            <h1>
                                <field name="name" placeholder="Ticket name..."/>
                            </h1>
                        </div>
                        <group col="2">
                            <group>
                                <field name="property_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="responsible_id" domain="[('share', '=', False)]" />
                            </group>
                            <group>
                                <field name="ticket_type"/>
                                <field name="priority" widget="priority"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="estate_property_ticket_view_list" model="ir.ui.view">
            <field name="name">estate.property.ticket.view.list</field>
            <field name="model">estate.property.ticket</field>
            <field name="arch" type="xml">
                <list string="Real Estate Property Tickets" default_order="priority desc, id desc"
                      decoration-danger="state == 'canceled'" decoration-muted="state == 'done'">
                    <field name="ticket_ref_code" readonly="1"/>
                    <field name="name"/>
                    <field name="property_id"/>
                    <field name="responsible_id" widget="many2one_avatar_user" domain="[('share', '=', False)]" />
                    <field name="ticket_type" widget="badge"
                           decoration-info="ticket_type == 'issue'"
                           decoration-warning="ticket_type == 'request'"
                           decoration-success="ticket_type == 'task'"/>
                    <field name="description" optional="hide"/>
                    <field name="priority" widget="priority"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'in_progress'"
                           decoration-success="state == 'done'"
                           decoration-danger="state == 'canceled'"/>
                    <field name="date_new" optional="hide"/>
                    <field name="date_in_progress" optional="hide"/>
                    <field name="date_done" optional="hide"/>
                    <field name="date_canceled" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="estate_property_ticket_simple_view_list" model="ir.ui.view">
            <field name="name">estate.property.ticket.simple.view.list</field>
            <field name="model">estate.property.ticket</field>
            <field name="arch" type="xml">
                <list string="Real Estate Property Tickets" default_order="id desc" editable="bottom">
                    <field name="sequence" widget="handle" />
                    <field name="ticket_ref_code" readonly="1"/>
                    <field name="ticket_type"/>
                    <field name="responsible_id" domain="[('share', '=', False)]" widget="many2one_avatar_user" />
                    <field name="description" />
                    <field name="priority" widget="priority"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'in_progress'"
                           decoration-success="state == 'done'"
                           decoration-danger="state == 'canceled'"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="estate_property_ticket_view_action" model="ir.actions.act_window">
            <field name="name">Property Tickets</field>
            <field name="res_model">estate.property.ticket</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('estate_property_ticket_view_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('estate_property_ticket_view_form')})]"/>
        </record>

    </data>
</odoo>
