<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- ###### property_visit -->  

        <record id="estate_property_visit_view_list" model="ir.ui.view">
            <field name="name">estate.property.visit.view.list</field>
            <field name="model">estate.property.visit</field>
            <field name="arch" type="xml">
                <list string="Real Estate Property Visit" default_order="name desc">
                    <field name="listing_id" />
                    <field name="property_id" />
                    <field name="visitor_id" widget="many2one_avatar_user"/>
                    <field name="agent_id" widget="many2one_avatar_user" />
                    <field name="date" />
                    <field name="stage_id" widget="badge" decoration-info="stage_id_code == 'confirmed'" decoration-success="stage_id_code == 'done'" decoration-danger="stage_id_code == 'canceled'"/>
                </list>
            </field>
        </record>

        <record id="estate_property_visit_view_form" model="ir.ui.view">
            <field name="name">estate.property.visit.view.form</field>
            <field name="model">estate.property.visit</field>
            <field name="arch" type="xml">
                <form string="Real Estate Property Visit">
                <header>
                    <button string="Draft" name="action_draft" type="object" class="oe_highlight" invisible="stage_id_code in ('draft','done', 'canceled')"/>
                    <button string="Cancel" name="action_canceled" type="object" class="oe_highlight btn-danger" invisible="stage_id_code in ('canceled','draft', 'done')"/>
                    <button string="Confirm" name="action_confirmed" type="object" class="oe_highlight" invisible="stage_id_code in ('confirmed','canceled', 'done')" />
                    <button string="Done" name="action_done" type="object" class="oe_highlight btn-success" invisible="stage_id_code in ('done','draft', 'canceled')"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}" />
                </header>
                    <sheet>
                    <widget name="web_ribbon"
                        title="Done" 
                        bg_color="text-bg-success" 
                        invisible="not stage_id_code == 'done'"/>
                        <group>
                            <field name="listing_id" />
                            <field name="property_id"/>
                            <field name="visitor_id" widget="many2one_avatar_user" />
                            <field name="agent_id" widget="many2one_avatar_user" />
                            <field name="date" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="estate_property_visit_view_search" model="ir.ui.view">
            <field name="name">estate.property.visit.view.search</field>
            <field name="model">estate.property.visit</field>
            <field name="arch" type="xml">
                <search string="Real Estate Property Visit">
                    <field name="name"/>
                    <field name="listing_id"/>
                    <field name="property_id"/>
                    <field name="visitor_id"/>
                    <field name="agent_id"/>
                    <field name="date"/>
                    <separator/>
                    <filter string="Draft" name="filter_draft" domain="[('stage_id_code', '=', 'draft')]"/>
                    <filter string="Confirmed" name="filter_confirmed" domain="[('stage_id_code', '=', 'confirmed')]"/>
                    <filter string="Done" name="filter_done" domain="[('stage_id_code', '=', 'done')]"/>
                    <filter string="Canceled" name="filter_canceled" domain="[('stage_id_code', '=', 'canceled')]"/>
                    <separator/>
                    <filter string="My Visits" name="filter_my_visits" domain="[('agent_id', '=', uid)]"/>
                    <filter string="Today" name="filter_today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                    <group>
                        <filter string="Status" name="groupby_state" context="{'group_by': 'stage_id'}"/>
                        <filter string="Listing" name="groupby_listing" context="{'group_by': 'listing_id'}"/>
                        <filter string="Property" name="groupby_property" context="{'group_by': 'property_id'}"/>
                        <filter string="Agent" name="groupby_agent" context="{'group_by': 'agent_id'}"/>
                        <filter string="Date" name="groupby_date" context="{'group_by': 'date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Kanban-->
        <record id="estate_property_visit_view_kanban" model="ir.ui.view">
            <field name="name">estate.property.visit.view.kanban</field>
            <field name="model">estate.property.visit</field>
            <field name="arch" type="xml">
                <kanban highlight_color="color" default_group_by="stage_id" class="o_kanban_small_column o_opportunity_kanban" on_create="quick_create">
                    <field name="stage_id"/>
                    <field name="stage_id_code"/>
                    <templates>
                        <t t-name="menu">
                            <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Edit</a></t>
                            <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                            <div role="separator" class="dropdown-divider"/>
                            <field name="color" widget="kanban_color_picker"/>
                        </t>
                        <t t-name="card">
                            <widget name="web_ribbon" id="visit_done" title="Done" bg_color="text-bg-success" invisible="stage_id_code != 'done'"/>
                            <widget name="web_ribbon" id="visit_canceled" title="Canceled" bg_color="text-bg-danger" invisible="stage_id_code != 'canceled'"/>

                            <div class="oe_kanban_global_click">
                                <div class="d-flex justify-content-between">
                                    <strong><field name="visitor_id"/></strong>
                                    <field name="stage_id" widget="badge" decoration-info="stage_id_code == 'confirmed'" decoration-success="stage_id_code == 'done'" decoration-danger="stage_id_code == 'canceled'"/>
                                </div>
                                <div><field name="listing_id"/></div>
                                <div><field name="property_id"/></div>
                                <div class="text-muted"><field name="agent_id"/></div>
                                <div class="text-muted"><field name="date"/></div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- pivot -->
        <record id="estate_property_visit_view_pivot" model="ir.ui.view">
            <field name="name">estate.property.visit.view.pivot</field>
            <field name="model">estate.property.visit</field>
            <field name="arch" type="xml">
                <pivot string="Real Estate Property Visit">
                    <field name="agent_id" type="row"/>
                    <field name="stage_id" type="col"/>
                    <field name="date" interval="month" type="row"/>
                </pivot>
            </field>
        </record>

        <!-- graph -->
        <record id="estate_property_visit_view_graph" model="ir.ui.view">
            <field name="name">estate.property.visit.view.graph</field>
            <field name="model">estate.property.visit</field>
            <field name="arch" type="xml">
                <graph string="Real Estate Property Visit" type="bar">
                    <field name="date" interval="month"/>
                    <field name="stage_id"/>
                </graph>
            </field>
        </record>

        <record id="estate_property_visit_view_calendar" model="ir.ui.view">
            <field name="name">estate.property.visit.view.calendar</field>
            <field name="model">estate.property.visit</field>
            <field name="arch" type="xml">
                <calendar string="Real Estate Property Visit" date_start="date" color="color">
                    <field name="listing_id"/>
                    <field name="property_id"/>
                    <field name="visitor_id"/>
                    <field name="agent_id"/>
                </calendar>
            </field>
        </record>

        <!-- Action -->
        <record id="estate_property_visit_view_action" model="ir.actions.act_window">
            <field name="name">Estate Property Visits</field>
            <field name="res_model">estate.property.visit</field>
            <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
            <field name="search_view_id" ref="estate_property_visit_view_search"/>
            <field name="context">{'search_default_groupby_state': 1}</field>
        </record>

    </data>
</odoo>
