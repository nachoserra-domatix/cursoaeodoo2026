<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="real_estate_rule_user" model="ir.rule">
        <field name="name">Personal Properties</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="domain_force">['|',('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_real_estate_user'))]"/>
    </record>

    <record id="real_estate_rule_manager" model="ir.rule">
        <field name="name">All Properties</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_real_estate_manager'))]"/>
    </record>

</odoo>
