<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="view_estate_visit_stage_update_form" model="ir.ui.view">
            <field name="name">estate.visit.stage.update.form</field>
            <field name="model">estate.visit.stage.update</field>
            <field name="arch" type="xml">
                <form string="Update Visits Stage">
                    <group>
                        <field name="new_stage_id"/>
                    </group>
                    <footer>
                        <button name="action_apply_stage_update" type="object" string="Apply" class="btn-primary" data-hotkey="q"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="estate_visit_stage_update_action" model="ir.actions.act_window">
            <field name="name">Update Visits Stage</field>
            <field name="res_model">estate.visit.stage.update</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="real_estate_mstiehl.model_estate_property_visit"/>
            <field name="binding_view_types">list,form</field>
        </record>

    </data>
</odoo>
