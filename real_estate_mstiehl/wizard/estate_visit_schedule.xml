<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="view_estate_visit_schedule_form" model="ir.ui.view">
            <field name="name">estate.visit.schedule.form</field>
            <field name="model">estate.visit.schedule</field>
            <field name="arch" type="xml">
                <form string="Schedule Visit">
                    <group>
                        <field name="listing_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <group>
                            <field name="agent_id" widget="many2one_avatar_user"/>
                            <field name="visitor_id" widget="many2one_avatar"/>
                        </group>
                        <group>
                            <field name="date_start" string="Dates" widget="daterange" options="{'end_date_field': 'date_end'}"/>
                            <field name="date_end" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes for the visit..."/>
                    <footer>
                        <button name="action_schedule_visit" type="object" string="Schedule Visit" class="btn-primary" data-hotkey="q"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="estate_visit_schedule_action" model="ir.actions.act_window">
            <field name="name">Schedule Visit</field>
            <field name="res_model">estate.visit.schedule</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Action from multiple listings -->
        <record id="estate_visit_schedule_settings_action" model="ir.actions.act_window">
            <field name="name">Schedule Visit</field>
            <field name="res_model">estate.visit.schedule</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="real_estate_mstiehl.model_estate_listing"/>
            <field name="binding_view_types">list,form</field>
        </record>

    </data>
</odoo>
