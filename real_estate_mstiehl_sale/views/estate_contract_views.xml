<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_contract_sale_form" model="ir.ui.view">
        <field name="name">estate.contract.sale.form</field>
        <field name="model">estate.contract</field>
        <field name="inherit_id" ref="real_estate_mstiehl.view_estate_contract_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_create_order" string="Create Sale Order" type="object" class="oe_highlight" invisible="state != 'signed'"/>
                <button name="action_confirm_and_invoice" string="Confirm &amp; Invoice" type="object" class="oe_highlight" invisible="num_orders == 0"/>
            </header>
            <div name="button_box" position="inside">
                <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                    <field name="num_orders" string="Orders" widget="statinfo"/>
                </button>
            </div>
            <field name="property_id" position="after">
                <field name="product_id" required="state == 'signed'"/>
            </field>
        </field>
    </record>

</odoo>
