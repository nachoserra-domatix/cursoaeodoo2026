<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="module_category_real_estate" model="ir.module.category">
            <field name="name">Real Estate</field>
            <field name="sequence">10</field>
        </record>
        <record id="res_groups_privilege_real_estate" model="res.groups.privilege">
            <field name="name">Real Estate</field>
            <field name="category_id" ref="module_category_real_estate"/>
        </record>
        <record id="group_real_estate_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_real_estate"/>
            <field name="comment">Real Estate User Group</field>
        </record>
        <record id="group_real_estate_manager" model="res.groups">
            <field name="name">Manage</field>
            <field name="privilege_id" ref="res_groups_privilege_real_estate"/>
            <field name="implied_ids" eval="[(4, ref('group_real_estate_user'))]"/>
            <field name="comment">Real Estate Manager Group</field>
        </record>
        <record id="estate_property_rule_user" model="ir.rule">
            <field name="name">Personal Property</field>
            <field name="model_id" ref="model_estate_property"/>
            <field name="domain_force">[('id_user','=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_real_estate_user'))]"/>
        </record>
        <record id="estate_property_rule_manager" model="ir.rule">
            <field name="name">All Property</field>
            <field name="model_id" ref="model_estate_property"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_real_estate_manager'))]"/>
        </record>
    </data>
</odoo>
