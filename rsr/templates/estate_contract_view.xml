<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="estate_contract_view_form" model="ir.ui.view">
        <field name="name">realestate.contract.form</field>
        <field name="model">realestate.contract</field>
        <field name="arch" type="xml">
            <form string="Real Estate Contract">
                <header>
                    <button name="action_mark_in_progress" invisible="state != 'draft'" type="object" string="Start Contract" class="btn-primary"/>
                    <button name="action_mark_finished" invisible="state != 'in_progress'" type="object" string="Finish Contract" class="btn-primary"/>
                    <button name="action_mark_cancelled" invisible="state not in ['draft', 'in_progress']" type="object" string="Cancel Contract" class="btn-secondary"/>
                    <button name="action_mark_draft" invisible="state not in ['finished', 'cancelled']" type="object" string="Reset to Draft" class="btn-secondary"/>
                    <field name="state" widget="statusbar" options="{'clickable': True}" statusbar_visible="draft,in_progress,finished,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Contract Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_type"/>
                            <field name="property_id"/>
                            <field name="tenant_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="rent"/>
                            <field name="deposit"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="estate_contract_view_list" model="ir.ui.view">
        <field name="name">realestate.contract.list</field>
        <field name="model">realestate.contract</field>
        <field name="arch" type="xml">
            <list string="Real Estate Contracts">
                <field name="name"/>
                <field name="contract_type"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="rent"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="estate_contract_view_search" model="ir.ui.view">
        <field name="name">realestate.contract.search</field>
        <field name="model">realestate.contract</field>
        <field name="arch" type="xml">
            <search string="Search Real Estate Contracts">
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="contract_type"/>
                <field name="state"/>
                <group>
                    <filter string="Property" name="group_by_property" context="{'group_by': 'property_id'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
