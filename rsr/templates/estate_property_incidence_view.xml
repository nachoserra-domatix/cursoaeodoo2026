<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="estate_property_incidence_view_form" model="ir.ui.view">
        <field name="name">estate.property.incidence.form</field>
        <field name="model">estate.property.incidence</field>
        <field name="arch" type="xml">
            <form string="Property Incidence">
                <sheet>
                    <group>
                        <group>
                            <field name="property_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="state"/>
                            <field name="date"/>
                            <field name="user_id" domain="[('share', '=', False)]"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="estate_property_incidence_view_list" model="ir.ui.view">
        <field name="name">estate.property.incidence.list</field>
        <field name="model">estate.property.incidence</field>
        <field name="arch" type="xml">
            <list string="Property Incidences" default_order="sequence asc">
                <field name="sequence"/>
                <field name="property_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="name"/>
                <field name="priority" widget="priority"/>
                <field name="state"/>
                <field name="date"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
</odoo>