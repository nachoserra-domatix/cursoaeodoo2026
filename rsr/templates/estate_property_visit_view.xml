<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="estate_property_visit_view_form" model="ir.ui.view">
        <field name="name">estate.property.visit.form</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <form string="Property Visit">
                <header>
                    <button name="action_mark_new" invisible="state != 'draft'" type="object" string="Mark as New" class="btn-secondary"/>
                    <button name="action_mark_planned" invisible="state != 'new'" type="object" string="Mark as Planned" class="btn-secondary"/>
                    <button name="action_mark_done" invisible="state != 'planned'" type="object" string="Mark as Done" class="btn-primary"/>
                    <button name="action_mark_cancelled" invisible="state not in ['new', 'planned']" type="object" string="Mark as Cancelled" class="btn-secondary"/>
                    <button name="action_mark_draft" invisible="state not in ['done', 'cancelled']" type="object" string="Mark as Draft" class="btn-secondary"/>
                    <field name="state" widget="statusbar" options="{'clickable': True}" statusbar_visible="draft,new,planned,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="contact_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="estate_property_visit_view_list" model="ir.ui.view">
        <field name="name">estate.property.visit.list</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <list string="Property Visits">
                <field name="property_id"/>
                <field name="date"/>
                <field name="contact_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="estate_property_visit_view_search" model="ir.ui.view">
        <field name="name">estate.property.visit.search</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <search string="Search Property Visits">
                <field name="property_id"/>
                <field name="contact_id"/>
                <field name="state"/>
                <group>
                    <filter string="Property" name="group_by_property" context="{'group_by': 'property_id'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>