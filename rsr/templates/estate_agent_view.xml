<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="estate_agent_view_form" model="ir.ui.view">
        <field name="name">realestate.agent.form</field>
        <field name="model">realestate.agent</field>
        <field name="arch" type="xml">
            <form string="Real Estate Agent">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Agent Name"/></h1>
                    </div>
                    <group>
                        <group string="Address">
                            <field name="street"/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="estate_agent_view_list" model="ir.ui.view">
        <field name="name">realestate.agent.list</field>
        <field name="model">realestate.agent</field>
        <field name="arch" type="xml">
            <list string="Real Estate Agents">
                <field name="name"/>
                <field name="street"/>
                <field name="city"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>
</odoo>
