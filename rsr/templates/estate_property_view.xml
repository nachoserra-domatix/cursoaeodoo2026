<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate Property">
                <sheet>
                    <widget name="web_ribbon"
                            title="Reserved"
                            bg_color="text-bg-warning"
                            invisible="availability_state"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Property Title"/></h1>
                    </div>
                    <group>
                        <group string="Description">
                            <field name="description"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                            <field name="availability_state" widget="boolean_toggle" options="{'terminology': {'on': 'Available', 'off': 'Not Available'}}"/>
                        </group>
                        <group string="Area (m²)">
                            <field name="living_area"/>
                            <field name="garden_area"/>
                            <field name="total_area" readonly="1"/>
                        </group>
                    </group>
                    <group string="Sale Information">
                        <group>
                            <field name="price"/>
                            <field name="best_price" readonly="1"/>
                        </group>
                        <group>
                            <field name="selling_price" readonly="1"/>
                            <field name="id_user"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Estate Properties">
                <field name="name"/>
                <field name="postcode"/>
                <field name="price"/>
                <field name="date_availability"/>
                <field name="availability_state" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Estate Properties">
                <field name="name"/>
                <field name="postcode"/>
                <filter string="Available" name="available" domain="[('availability_state', '=', True)]"/>
                <group>
                    <filter string="Owner" name="group_by_user" context="{'group_by': 'id_user'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>