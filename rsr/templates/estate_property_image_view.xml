<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="estate_property_image_view_form" model="ir.ui.view">
        <field name="name">estate.property.image.form</field>
        <field name="model">estate.property.image</field>
        <field name="arch" type="xml">
            <form string="Property Image">
                <sheet>
                    <group>
                        <field name="property_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="sequence"/>
                        <field name="name"/>
                        <field name="image" widget="image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="estate_property_image_view_list" model="ir.ui.view">
        <field name="name">estate.property.image.list</field>
        <field name="model">estate.property.image</field>
        <field name="arch" type="xml">
            <list string="Property Images" default_order="sequence asc">
                <field name="sequence"/>
                <field name="property_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="name"/>
                <field name="image" widget="image"/>
            </list>
        </field>
    </record>
</odoo>
