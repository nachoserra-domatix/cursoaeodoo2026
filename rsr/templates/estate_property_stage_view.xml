<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="estate_property_stage_view_form" model="ir.ui.view">
        <field name="name">realestate.property.stage.form</field>
        <field name="model">realestate.property.stage</field>
        <field name="arch" type="xml">
            <form string="Property Stage">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="estate_property_stage_view_list" model="ir.ui.view">
        <field name="name">realestate.property.stage.list</field>
        <field name="model">realestate.property.stage</field>
        <field name="arch" type="xml">
            <list string="Property Stages" default_order="sequence asc">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>
</odoo>
