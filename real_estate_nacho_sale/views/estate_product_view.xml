<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="estate_product_form_view" model="ir.ui.view">
        <field name="name">product.form.estate.rental</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="group_general" position="inside">
                <field name="is_rental"/>
                <field name="estate_property_id" invisible="not is_rental" required="is_rental"/>
            </group>
        </field>
    </record>
</odoo>