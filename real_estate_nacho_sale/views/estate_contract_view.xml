<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="estate_contract_view_form_sale" model="ir.ui.view">
        <field name="name">realestate.contract.form.sale</field>
        <field name="model">realestate.contract</field>
        <field name="inherit_id" ref="rsr.estate_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_create_sale_order" type="object" string="Create Sales Order" class="btn-primary" invisible="not product_id"/>
                <button name="action_confirm_and_invoice_orders" type="object" string="Confirm and Invoice Orders" class="btn-secondary" invisible="order_count == 0"/>
            </xpath>
            <xpath expr="//field[@name='contract_type']" position="after">
                <field name="product_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                    <field name="order_count" widget="statinfo" string="Sales Orders"/>
                </button>
            </xpath>
        </field>
    </record>
    <record id="sale_order_view_form_contract" model="ir.ui.view">
        <field name="name">sale.order.form.contract</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']" position="inside">
                <group string="Real Estate">
                    <field name="contract_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
